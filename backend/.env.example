APP_NAME=BoutiqueOS
ENVIRONMENT=development
DATABASE_URL=sqlite:///./boutiqueos.db
LOG_LEVEL=INFO
HOLD_TTL_HOURS=24
HOLD_DEFAULT_TTL_HOURS=24
REMNANT_THRESHOLD_M=0.5
CORS_ORIGINS=http://localhost:5173
MEDIA_STORAGE_PATH=./data/media
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_VIDEO_MB=100
INTEGRATION_PROCESSING_BATCH_SIZE=20
INTEGRATION_RETRY_LIMIT=3

# Google Virtual Try-On (credentials are server-only Application Default Credentials)
TRYON_ENABLED=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
TRYON_MODEL=virtual-try-on-001
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/service-account.json

# AI policy foundation: development only until admin authentication and ledger ship
AI_POLICY_ADMIN_ENABLED=false
TRYON_PROVIDER=huggingface
FABRIC_DESIGN_ENABLED=false
FABRIC_DESIGN_MODEL=gemini-2.5-flash-image
FABRIC_DESIGN_LOCATION=global
