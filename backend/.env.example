APP_NAME=BoutiqueOS
ENVIRONMENT=development
DATABASE_URL=sqlite:///./boutiqueos.db
LOG_LEVEL=INFO
HOLD_TTL_HOURS=24
HOLD_DEFAULT_TTL_HOURS=24
REMNANT_THRESHOLD_M=0.5
CORS_ORIGINS=http://localhost:5173
MEDIA_STORAGE_PATH=./data/media
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_VIDEO_MB=100
INTEGRATION_PROCESSING_BATCH_SIZE=20
INTEGRATION_RETRY_LIMIT=3
